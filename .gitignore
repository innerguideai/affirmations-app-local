# ===========================================
# AI AFFIRM — .gitignore
# ===========================================

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment / secrets (NEVER commit)
.env
.env.local
.env*.local
*.env

# MongoDB local dumps
dump/

# OS files
.DS_Store
Thumbs.db

# Backups / archives / junk
*.bak
*.bak.*
*copy*
*.tgz
*.tar.gz
archive/
_backups/
backups/
ios_backup_*/
ios.bak_*/
public_backup_*/
ios_App_public_backup_*/

# iOS — Xcode user state
**/xcuserdata/
**/*.xcuserstate
ios/App/App.xcodeproj/xcshareddata/

# iOS — CocoaPods
ios/App/Pods/
ios/App/Podfile.lock

# iOS — generated web bundle (source of truth is /public)
ios/App/App/public/

# Android — secrets (NEVER commit)
android/keystore.properties
android/keystores/*.jks

# Android — build artifacts
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/

# Android — IDE noise
*.iml
.idea/
android/.idea/
android/captures/
android/app/.cxx/

# Appium / test artifacts
appium-*.xml
appium-*.js
appium.md

# Misc
users.json
ai-affirm-release.keystore
